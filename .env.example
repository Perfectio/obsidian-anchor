# Anchor runs fully local with NO API key. These are OPTIONAL upgrades.
# Copy to .env (gitignored) and fill in only what you want.

# Use the Claude Haiku grounding verifier (higher accuracy). Auto-detected when set.
# Force the local verifier instead with ANCHOR_VERIFIER=local.
ANTHROPIC_API_KEY=

# Use OpenAI embeddings instead of local. Also set ANCHOR_EMBEDDING=openai.
# Note: with this enabled, note text is sent to the OpenAI API.
OPENAI_API_KEY=
